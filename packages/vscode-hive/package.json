{
  "name": "vscode-arkive",
  "displayName": "Arkive",
  "description": "View and review Agent Hive .hive workspaces",
  "version": "5.1.0",
  "publisher": "arkive",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/imarshallwidjaja/agent-hive.git",
    "directory": "packages/vscode-hive"
  },
  "homepage": "https://github.com/imarshallwidjaja/agent-hive#readme",
  "bugs": {
    "url": "https://github.com/imarshallwidjaja/agent-hive/issues"
  },
  "keywords": [
    "ai",
    "arkive",
    "hive",
    "opencode",
    "planning",
    "workflow"
  ],
  "engines": {
    "vscode": "^1.67.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:hive.features",
    "onView:hive.backgroundJobs",
    "onView:hive.repositories",
    "onView:hive.worklogs",
    "onCommand:hive.refresh",
    "onCommand:hive.openFile",
    "onCommand:hive.copyToClipboard",
    "onCommand:hive.plan.doneReview",
    "onCommand:hive.comment.create",
    "onCommand:hive.comment.reply",
    "onCommand:hive.comment.resolve",
    "onCommand:hive.comment.delete",
    "onCommand:hive.feature.archive",
    "onCommand:hive.job.archive",
    "onCommand:hive.context.archive",
    "onCommand:hive.context.loadMore",
    "onCommand:hive.context.scanChars",
    "onCommand:hive.constraints.inspect",
    "onCommand:hive.worklog.open",
    "onCommand:hive.worklog.showHistory",
    "onCommand:hive.worklog.showFacts",
    "onCommand:hive.worklog.pin",
    "onCommand:hive.worklog.unpin",
    "onCommand:hive.worklog.loadMore"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hive",
          "title": "Hive",
          "icon": "resources/icons/hive.svg"
        }
      ]
    },
    "views": {
      "hive": [
        {
          "id": "hive.features",
          "name": "Features"
        },
        {
          "id": "hive.backgroundJobs",
          "name": "Background Jobs"
        },
        {
          "id": "hive.repositories",
          "name": "Tracked Repositories"
        },
        {
          "id": "hive.worklogs",
          "name": "Worklogs"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "hive.features",
        "contents": "No Hive workspace found.\n\nCreate or open a workspace containing `.hive`, then refresh this view.\n\n[Refresh](command:hive.refresh)",
        "when": "!hive.hasHiveRoot"
      },
      {
        "view": "hive.backgroundJobs",
        "contents": "No Hive workspace found.\n\nOpen a Hive workspace to view background jobs.\n\n[Refresh](command:hive.refresh)",
        "when": "!hive.hasHiveRoot"
      },
      {
        "view": "hive.repositories",
        "contents": "No Hive workspace found.\n\nOpen a Hive workspace to view tracked repositories.\n\n[Refresh](command:hive.refresh)",
        "when": "!hive.hasHiveRoot"
      },
      {
        "view": "hive.worklogs",
        "contents": "No Hive workspace found.\n\nOpen a Hive workspace to read its worklogs.\n\n[Refresh](command:hive.refresh)",
        "when": "!hive.hasHiveRoot"
      }
    ],
    "commands": [
      {
        "command": "hive.context.archive",
        "title": "Archive Context"
      },
      {
        "command": "hive.context.loadMore",
        "title": "Load More Context Documents"
      },
      {
        "command": "hive.context.scanChars",
        "title": "Scan Context Character Totals"
      },
      {
        "command": "hive.constraints.inspect",
        "title": "Hive: Inspect Session Standing Constraints"
      },
      {
        "command": "hive.refresh",
        "title": "Hive: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "hive.openFile",
        "title": "Open File"
      },
      {
        "command": "hive.copyToClipboard",
        "title": "Copy ID"
      },
      {
        "command": "hive.plan.doneReview",
        "title": "Done Review",
        "icon": "$(check)"
      },
      {
        "command": "hive.comment.create",
        "title": "Add Comment",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "hive.comment.reply",
        "title": "Reply",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "hive.comment.resolve",
        "title": "Resolve Thread"
      },
      {
        "command": "hive.comment.delete",
        "title": "Delete Comment"
      },
      {
        "command": "hive.feature.archive",
        "title": "Archive Feature"
      },
      {
        "command": "hive.job.archive",
        "title": "Archive Background Job"
      },
      {
        "command": "hive.worklog.open",
        "title": "Hive: Open Worklog...",
        "icon": "$(search)"
      },
      {
        "command": "hive.worklog.showHistory",
        "title": "Show Worklog History",
        "icon": "$(history)"
      },
      {
        "command": "hive.worklog.showFacts",
        "title": "Show Worklog Facts",
        "icon": "$(checklist)"
      },
      {
        "command": "hive.worklog.pin",
        "title": "Pin Worklog",
        "icon": "$(pin)"
      },
      {
        "command": "hive.worklog.unpin",
        "title": "Unpin Worklog",
        "icon": "$(pinned)"
      },
      {
        "command": "hive.worklog.loadMore",
        "title": "Load More Worklog Entries",
        "icon": "$(fold-down)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "hive.refresh",
          "when": "view == hive.features",
          "group": "navigation"
        },
        {
          "command": "hive.refresh",
          "when": "view == hive.backgroundJobs",
          "group": "navigation"
        },
        {
          "command": "hive.refresh",
          "when": "view == hive.repositories",
          "group": "navigation"
        },
        {
          "command": "hive.worklog.open",
          "when": "view == hive.worklogs",
          "group": "navigation@1"
        },
        {
          "command": "hive.refresh",
          "when": "view == hive.worklogs",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "hive.context.archive",
          "when": "view == hive.features && (viewItem == context-folder || viewItem == project-context-folder || viewItem == context-file)"
        },
        {
          "command": "hive.context.scanChars",
          "when": "view == hive.features && (viewItem == context-folder || viewItem == project-context-folder)"
        },
        {
          "command": "hive.openFile",
          "when": "viewItem == file"
        },
        {
          "command": "hive.openFile",
          "when": "viewItem =~ /^background-job-/ || viewItem == tracked-repository || viewItem == background-jobs-state || viewItem == tracked-repositories-state"
        },
        {
          "command": "hive.copyToClipboard",
          "when": "viewItem =~ /^background-job-/ || viewItem == tracked-repository"
        },
        {
          "command": "hive.feature.archive",
          "when": "viewItem =~ /^feature-(planning|approved|executing)$/",
          "group": "inline"
        },
        {
          "command": "hive.job.archive",
          "when": "viewItem == background-job-archiveable",
          "group": "inline"
        },
        {
          "command": "hive.worklog.pin",
          "when": "view == hive.worklogs && viewItem =~ /^worklog-(log|problem)$/",
          "group": "inline"
        },
        {
          "command": "hive.worklog.unpin",
          "when": "view == hive.worklogs && viewItem =~ /^worklog-(log|problem)-pinned$/",
          "group": "inline"
        },
        {
          "command": "hive.worklog.pin",
          "when": "view == hive.features && viewItem == feature-worklog",
          "group": "worklog@3"
        },
        {
          "command": "hive.worklog.showHistory",
          "when": "viewItem =~ /^worklog-log/ || viewItem == feature-worklog",
          "group": "worklog@1"
        },
        {
          "command": "hive.worklog.showFacts",
          "when": "viewItem =~ /^worklog-log/ || viewItem == feature-worklog",
          "group": "worklog@2"
        },
        {
          "command": "hive.copyToClipboard",
          "when": "viewItem =~ /^worklog-(log|problem)/ || viewItem == feature-worklog",
          "group": "worklog@4"
        }
      ],
      "commandPalette": [
        {
          "command": "hive.context.archive",
          "when": "false"
        },
        {
          "command": "hive.context.loadMore",
          "when": "false"
        },
        {
          "command": "hive.context.scanChars",
          "when": "false"
        },
        {
          "command": "hive.feature.archive",
          "when": "false"
        },
        {
          "command": "hive.job.archive",
          "when": "false"
        },
        {
          "command": "hive.worklog.showHistory",
          "when": "resourceScheme == hive-worklog"
        },
        {
          "command": "hive.worklog.showFacts",
          "when": "resourceScheme == hive-worklog"
        },
        {
          "command": "hive.worklog.pin",
          "when": "resourceScheme == hive-worklog"
        },
        {
          "command": "hive.worklog.unpin",
          "when": "resourceScheme == hive-worklog"
        },
        {
          "command": "hive.worklog.loadMore",
          "when": "resourceScheme == hive-worklog"
        }
      ],
      "editor/title": [
        {
          "command": "hive.plan.doneReview",
          "when": "resourceFilename =~ /^(plan|overview)\\.md$/",
          "group": "navigation"
        },
        {
          "command": "hive.worklog.showHistory",
          "when": "resourceScheme == hive-worklog",
          "group": "navigation@1"
        },
        {
          "command": "hive.worklog.showFacts",
          "when": "resourceScheme == hive-worklog",
          "group": "navigation@2"
        },
        {
          "command": "hive.worklog.loadMore",
          "when": "resourceScheme == hive-worklog",
          "group": "navigation@3"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "hive.comment.create",
          "group": "inline",
          "when": "commentController == hive-plan-review && commentThreadIsEmpty"
        },
        {
          "command": "hive.comment.reply",
          "group": "inline",
          "when": "commentController == hive-plan-review && !commentThreadIsEmpty"
        },
        {
          "command": "hive.comment.resolve",
          "group": "inline",
          "when": "commentController == hive-plan-review && !commentThreadIsEmpty"
        }
      ],
      "comments/comment/title": [
        {
          "command": "hive.comment.delete",
          "group": "inline",
          "when": "commentController == hive-plan-review"
        }
      ]
    }
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node16 --sourcemap --minify-whitespace --define:import.meta.url=__importMetaUrl --define:__HIVE_KOFFI_MODULE__='\"./native/koffi/index.js\"' --banner:js=\"const __importMetaUrl = require('url').pathToFileURL(__filename).href;\" && node scripts/copy-native-koffi.cjs",
    "package": "bun run build && vsce package --no-dependencies -o vscode-arkive.vsix",
    "watch": "npm run build -- --watch",
    "build:types": "tsc --emitDeclarationOnly",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/vscode": "1.67.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.2",
    "koffi": "2.16.3",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "hive-core": "5.1.0"
  }
}
